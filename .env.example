# Field Intelligence OS — environment template
#
# Copy to `.env.local` and fill in as each integration is implemented.
#
# PHASE 00 REQUIRES NONE OF THESE. The application builds, runs, tests and
# deploys with no `.env` file at all — the Command Center is served from typed
# static seed data. Absent values are handled explicitly, not silently.
#
# NEVER commit real values. `.env*` is gitignored except this file.

# ---------------------------------------------------------------------------
# Browser-safe. Inlined into the client bundle at build time — treat everything
# here as public. The publishable (anon) key is safe to expose *only* because
# Row Level Security is enabled on every table it can reach.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only. Never prefix any of these with NEXT_PUBLIC_.
#
# The service-role key bypasses Row Level Security entirely, so leaking it
# defeats every access control in the product at once. It is read in exactly
# one module (`lib/supabase/server.ts`, marked `server-only`), and that
# boundary is enforced by ESLint and by tests/unit/security-boundaries.test.ts.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional integrations. Added only when the corresponding phase implements
# them; an unset value must never silently disable a security control.
# ---------------------------------------------------------------------------

# Google Drive — canonical media vault (Phase 06, ADR-003)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# Notion — optional readable mirror, never canonical (Phase 08, ADR-001)
NOTION_INTEGRATION_TOKEN=
NOTION_ROOT_PAGE_ID=
